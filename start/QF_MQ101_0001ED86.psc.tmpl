Scriptname Fragments:Quests:QF_MQ101_0001ED86 Extends Quest Hidden
{Fallout 4-Ever: replaces the fragment script of the vanilla intro quest MQ101 (loose file, shadows the one in the game archives).
Fallout 4 runs stage 0 item 01 at New Game (pre-war intro movie, mirror chargen, control lock). Here that item gives the engine the blank movie it waits for, moves the
player outside Vault 101 and starts our start quest; every other fragment does nothing, so MQ101 is never advanced. Uninstalling the mod removes this file and restores
the normal Fallout 4 start.}

Function Fragment_Stage_0000_Item_00()
EndFunction

Function Fragment_Stage_0000_Item_01()
	Debug.Trace("F4EVER fragment: New Game, MQ101 stage 0 item 1 runs")
	; the engine waits for its new-game movie call: give it a 2-frame black Bink movie (a missing file would hang the load)
	Game.PlayBink("F3Blank.bik", true, true, true, true, true)
	; the movie alone leaves the loading screen waiting forever: move the player ourselves (same as the console command coc), to the spot outside the vault door
	ObjectReference exitRef = Game.GetFormFromFile(@EXIT@, "Fallout3.esm") as ObjectReference
	If exitRef != None
		Game.GetPlayer().MoveTo(exitRef)
	Else
		Debug.CenterOnCell("Vault101Exterior")
	EndIf
	Quest q = Game.GetFormFromFile(@QSTART@, "CapitalStart.esp") as Quest
	Debug.Trace("F4EVER fragment: start quest " + q)
	If q != None
		If !q.IsRunning()
			q.Start()
		EndIf
		CapStartDemo cs = q as CapStartDemo
		If cs != None
			cs.StartTimer(1.5, 1)          ; the rest runs on its own thread: this fragment must return, the loading screen waits for it
		EndIf
	EndIf
EndFunction

